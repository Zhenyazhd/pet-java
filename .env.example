POSTGRES_DB=job_search
POSTGRES_USER=zhenya
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# S3-compatible storage (adobe/s3mock locally; same AWS SDK works with R2/AWS later)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_BUCKET=job-search-cvs
S3_PATH_STYLE=true
S3_PORT=9090

# Auth — required: bootstrap ADMIN email (invite codes). No code default — set explicitly.
APP_ADMIN_EMAIL=you@example.com
APP_BOOTSTRAP_PASSWORD=changeme
# Comma-separated SPA origins for credentialed CORS (prod: https://your.app)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Auth brute-force guard (per client IP, fixed 1-minute window; 0 disables)
APP_AUTH_LOGIN_PER_MINUTE=10
APP_AUTH_REGISTER_PER_MINUTE=5
# Trust X-Forwarded-For only from peers in APP_AUTH_TRUSTED_PROXIES (Vite/nginx).
# Leave false if browsers/clients can hit core-api directly — otherwise IPs are spoofable.
# Local Vite proxy: APP_AUTH_TRUST_FORWARDED_HEADERS=true (peer is 127.0.0.1).
APP_AUTH_TRUST_FORWARDED_HEADERS=false
APP_AUTH_TRUSTED_PROXIES=127.0.0.1,::1
# AI suggest / ATS match / vacancy import (per authenticated user / minute; 0 = off)
APP_EXPENSIVE_OPS_PER_USER_PER_MINUTE=10

# OpenRouter (https://openrouter.ai) — used for AI resume edits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local ATS Screener (tools/ats-screener) — vacancy match scores
ATS_SCREENER_BASE_URL=http://127.0.0.1:5174
# ATS_SCREENER_TIMEOUT_SECONDS=180
