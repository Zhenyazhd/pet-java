POSTGRES_DB=job_search
POSTGRES_HOST=localhost
POSTGRES_USER=zhenya
# Use a long random value in production.
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Auth — required: bootstrap ADMIN email (invite codes). No code default — set explicitly.
APP_ADMIN_EMAIL=you@example.com
# REQUIRED on first start (creates the ADMIN login): at least 12 characters; "changeme"-style placeholders are rejected at startup.
APP_BOOTSTRAP_PASSWORD=
# Production: true makes the app refuse to start with a weak POSTGRES_PASSWORD or PDF_WORKER_TOKEN (12+ characters, no placeholders). Leave false for local development.
APP_STRICT_SECRETS=false
# Database connections core-api may hold at once (default 10). Raise it only if you see requests waiting for one.
# DB_POOL_SIZE=10
# Comma-separated SPA origins for credentialed CORS (prod: https://your.app)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Behind a trusted reverse proxy (nginx/ALB) that appends to X-Forwarded-For and sets X-Forwarded-Proto
# use "native" (NOT "framework": it trusts the client-supplied leftmost address and defeats the auth
# rate limit). Set SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES (CIDR list or regex of proxy addresses) if the proxy is
# not in a private range. Leave "none" for local dev.
SERVER_FORWARD_HEADERS_STRATEGY=none
# Auth brute-force guard (per client IP, fixed 1-minute window; 0 disables)
APP_AUTH_LOGIN_PER_MINUTE=10
APP_AUTH_REGISTER_PER_MINUTE=5
# AI suggest / ATS match / vacancy import / resume PDF compile / job search (per user / minute; 0 = off)
APP_EXPENSIVE_OPS_PER_USER_PER_MINUTE=10

# OpenRouter (https://openrouter.ai) — used for AI resume edits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Seconds to wait for a model's answer (default 90)
# OPENROUTER_READ_TIMEOUT_SECONDS=90
# OpenRouter calls (AI chat, vacancy import) one core-api instance sends at once; more get "AI busy" (default 20)
# OPENROUTER_MAX_CONCURRENT_REQUESTS=20
# Longest answer in tokens; caps the cost of one call (default 8000)
# OPENROUTER_MAX_TOKENS=8000

# Typst → PDF worker (still named pdf-worker; tools/pdf-worker, started by `npm run infra:up`).
# Any random string; core-api and the worker must share it, and core-api refuses to start without it.
# Generate with: openssl rand -hex 32
PDF_WORKER_TOKEN=change-me
PDF_WORKER_PORT=8090
# PDF_WORKER_BASE_URL=http://127.0.0.1:8090
# PDF_WORKER_READ_TIMEOUT_SECONDS=75   must exceed the worker's 60s compile timeout

# ATS features (tools/ats-worker, started by `npm run infra:up`): the "can an ATS read my PDF" check and the vacancy
# match score. The match asks a model through the worker, which uses OPENROUTER_API_KEY above (SCORE_MODEL picks the
# model, default openai/gpt-4o-mini). Leave ATS_WORKER_ENABLED=false to hide both. core-api refuses to start with it
# enabled and no token.
# Generate with: openssl rand -hex 32
ATS_WORKER_ENABLED=true
ATS_WORKER_TOKEN=change-me-too
ATS_WORKER_PORT=8091
# ATS_WORKER_BASE_URL=http://127.0.0.1:8091
# ATS_WORKER_READ_TIMEOUT_SECONDS=30   must exceed the worker's 20s check timeout
# ATS_WORKER_SCORE_TIMEOUT_SECONDS=100  must exceed the worker's 90s model timeout
# SCORE_MODEL=openai/gpt-4o-mini   the model the worker asks for the vacancy match (compose passes it on)
# ATS_WORKER_CONCURRENCY=2   checks the worker runs at once
# SCORE_TIMEOUT_SECONDS=90   how long the worker waits for the model (keep core-api's ATS_WORKER_SCORE_TIMEOUT_SECONDS above it)
# SCORE_CONCURRENCY=4   model calls the worker makes at once
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   must be https (a local test server may use http://localhost)

# --- Job matches (optional, tools/job-list) ---------------------------------------------------------------------
# Off by default: without JOB_LIST_TOKEN the /jobs page says it is not switched on. Switch on with:
#   npm run infra:jobs:db && npm run infra:jobs     (see "Job matches (optional)" in README.md)
# WARNING: every search ("Search now") spends real money on Apify and OpenRouter. Defaults: 3 runs per user per day,
# Apify budget 5 USD and LLM budget 2 USD per UTC month (job-list stops calling them when a budget is used up).
# Password of the job_list database role (created in the same Postgres by `npm run infra:jobs:db`).
JOB_LIST_DB_PASSWORD=
# Bearer token core-api sends to job-list; job-list takes the same value as its core-api client token
# (JOB_LIST_CLIENT_0_TOKEN). core-api reads this variable, which also switches the feature on.
# Generate with: openssl rand -hex 24
JOB_LIST_TOKEN=
# Token of job-list's second client (Telegram bot, not wired yet); required by job-list, any random 16+ characters.
JOB_LIST_CLIENT_1_TOKEN=
# Where core-api reaches job-list
JOB_LIST_BASE_URL=http://127.0.0.1:8100
JOB_LIST_PORT=8100
# https://console.apify.com/settings/integrations
APIFY_TOKEN=
# A key of its own for job-list, with a credit limit set at OpenRouter; not the OPENROUTER_API_KEY above.
JOB_LIST_OPENROUTER_API_KEY=
# JOB_LIST_LLM_MODEL=deepseek/deepseek-chat
# APIFY_MONTHLY_BUDGET_USD=5
# JOB_LIST_LLM_MONTHLY_BUDGET_USD=2
# JOB_LIST_MAX_RUNS_PER_OWNER_PER_DAY=3
# JOB_LIST_MAX_RANK_RUNS_PER_OWNER_PER_DAY=20
# JOB_LIST_MAX_RANK_RUNS_PER_CLIENT_PER_DAY=200
# Sources to search. Each one is a paid Apify actor run. LinkedIn is off by default; the others are on.
# JOB_LIST_SOURCE_LINKEDIN_ENABLED=false
# JOB_LIST_SOURCE_HELLOWORK_ENABLED=true
# JOB_LIST_SOURCE_GREENHOUSE_ENABLED=true
# JOB_LIST_SOURCE_WTTJ_ENABLED=true
