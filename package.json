{
  "name": "job-search",
  "private": true,
  "version": "0.0.1",
  "description": "Root scripts to run infra + API + UI together",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose --profile jobs down",
    "infra:jobs:db": "docker compose --profile jobs run --rm job-list-db",
    "infra:jobs": "docker compose --profile jobs up -d --build --wait job-list",
    "infra:jobs:down": "docker compose --profile jobs rm -sf job-list job-list-db",
    "dev:api": "cd core-api && ./mvnw spring-boot:run",
    "dev:web": "npm --prefix frontend run dev",
    "predev": "npm run infra:up",
    "dev": "dotenv -e .env -- concurrently -k --restart-tries 0 -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:core": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
